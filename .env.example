# ---------------------------------------------------------------------------
# FitTrack environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL
#   Local:  http://127.0.0.1:54321   (printed by `npm run db:start`)
#   Hosted: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
#   Hosted: Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app, used in confirmation-email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rest-over notifications while the app is in the background (optional).
# Create a pair with:  npx web-push generate-vapid-keys
# The public key goes in the browser; keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Do NOT add the Supabase secret / service-role key here. FitTrack does not use it.
